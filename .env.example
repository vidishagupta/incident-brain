# Incident Brain Environment Configuration

# FalkorDB Connection
# If running locally via docker compose: redis://localhost:6379
# If using FalkorDB Cloud: redis://username:password@host:port
FALKORDB_URL=redis://localhost:6379
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# LLM Configuration
# Modes: "deterministic" (free, zero keys required, rule-based graph reasoning)
# Or set to "groq", "openai", "gemini" and provide LLM_API_KEY
LLM_PROVIDER=deterministic
LLM_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
